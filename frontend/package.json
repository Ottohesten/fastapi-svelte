{
    "name": "frontend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "svelte-kit sync && vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check .",
        "test": "bunx playwright test",
        "test:rich-editor:production": "PLAYWRIGHT_USE_PREVIEW=true bunx playwright test tests/rich-editor.spec.ts --workers=1",
        "test:unit": "bun test src/lib",
        "test:ui": "bunx playwright test --ui",
        "generate-client": "openapi-ts"
    },
    "dependencies": {
        "@ericblade/quagga2": "1.13.0",
        "@floating-ui/dom": "^1.8.0",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.61.0",
        "@sentry/sveltekit": "^11.9.0",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@tanstack/svelte-table": "^9.3.1",
        "@tanstack/table-core": "^9.3.1",
        "@tiptap/core": "3.32.0",
        "@tiptap/extension-color": "3.32.0",
        "@tiptap/extension-text-style": "3.32.0",
        "@tiptap/pm": "3.32.0",
        "@tiptap/starter-kit": "3.32.0",
        "bits-ui": "^2.20.2",
        "clsx": "^2.1.1",
        "d3": "^7.9.0",
        "dotenv": "^18.0.9",
        "formsnap": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "openapi-fetch": "^0.17.0",
        "parse5": "^8.0.1",
        "svelte": "^5.57.2",
        "sveltekit-superforms": "^3.0.0",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "valibot": "^1.5.0",
        "zod": "^4.6.7"
    },
    "overrides": {
        "prosemirror-model": "1.25.11",
        "prosemirror-transform": "1.12.0",
        "prosemirror-view": "1.42.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@playwright/test": "^1.64.1",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.4",
        "@types/d3": "^7.4.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.5",
        "autoprefixer": "^10.6.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass-embedded": "^1.106.1",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
