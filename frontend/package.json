{
    "name": "frontend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "svelte-kit sync && vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check .",
        "test": "bunx playwright test",
        "test:rich-editor:production": "PLAYWRIGHT_USE_PREVIEW=true bunx playwright test tests/rich-editor.spec.ts --workers=1",
        "test:unit": "bun test src/lib",
        "test:ui": "bunx playwright test --ui",
        "generate-client": "openapi-ts"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@ericblade/quagga2": "1.12.1",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.41.0",
        "@sentry/sveltekit": "^10.73.0",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@tanstack/table-core": "^8.21.3",
        "@tiptap/core": "3.31.3",
        "@tiptap/extension-color": "3.31.3",
        "@tiptap/extension-text-style": "3.31.3",
        "@tiptap/pm": "3.31.3",
        "@tiptap/starter-kit": "3.31.3",
        "bits-ui": "^2.19.0",
        "clsx": "^2.1.1",
        "d3": "^7.9.0",
        "dotenv": "^17.4.2",
        "formsnap": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "openapi-fetch": "^0.17.0",
        "svelte": "^5.57.0",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "valibot": "^1.4.2",
        "zod": "^4.5.4"
    },
    "overrides": {
        "prosemirror-model": "1.25.11",
        "prosemirror-transform": "1.12.0",
        "prosemirror-view": "1.42.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.1",
        "@types/d3": "^7.4.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.4.1",
        "autoprefixer": "^10.5.5",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass-embedded": "^1.104.0",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    }
}
